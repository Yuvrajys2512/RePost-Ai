# Shared
ENVIRONMENT=local

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://repost:repost@localhost:5432/repost_ai
REDIS_URL=redis://localhost:6379/0
USE_REDIS_QUEUE=false

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI Providers — set ONE of these. Priority: Claude > Groq > Gemini.
# Claude (paid, production quality): console.anthropic.com
ANTHROPIC_API_KEY=
# Groq (free, 14K req/day, Llama 3.3 70B): console.groq.com — best free option
GROQ_API_KEY=
# Gemini (free but limited quota): aistudio.google.com
GOOGLE_API_KEY=
OPENAI_API_KEY=

# YouTube / transcription
YOUTUBE_DATA_API_KEY=

# Billing / email / monitoring
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
RESEND_API_KEY=
SENTRY_DSN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — PostHog (posthog.com — free tier available)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry frontend source map upload (optional — only needed for production build)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
